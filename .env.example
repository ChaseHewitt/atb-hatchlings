# Firebase Web App configuration (Project settings → Your apps → Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Public reCAPTCHA Enterprise site key registered for this web app under
# Firebase console → App Check. Username sign-in and password reset need it.
VITE_FIREBASE_APP_CHECK_SITE_KEY=
# Optional, for `npm run dev` only: an App Check debug token already registered
# in the Firebase console. Leave empty to have one printed in the browser
# console. Keep it in .env.local and never commit it.
VITE_FIREBASE_APP_CHECK_DEBUG_TOKEN=
